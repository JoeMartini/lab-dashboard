// Lab Dashboard 服务配置模板
// 复制本文件为 config.js 后填入实际域名

/**
 * 服务条目字段说明：
 * - title: 显示名称
 * - href: 访问地址
 * - domain: 显示的域名
 * - desc: 描述
 * - icon: 图标
 * - avatarClass: 颜色样式 (accent|success|warning|amber|danger)
 * - source: { type: 'github'|'original'|'fork', url: '...', note: '...' }
 *   - github: 开源项目原仓库
 *   - original: 原创作品
 *   - fork: 基于开源项目本地改造，url 指向原仓库，note 描述改造内容
 */

window.LAB_SERVICES = [
  {
    category: "示例分类",
    categoryIcon: "🛠️",
    categoryId: "demo",
    items: [
      {
        title: "开源项目示例",
        href: "https://app.example.com",
        domain: "app.example.com",
        desc: "这是一个开源项目的描述",
        icon: "📦", avatarClass: "accent",
        source: { type: "github", url: "https://github.com/user/repo", note: "自托管部署，接入 OIDC" }
      },
      {
        title: "原创作品示例",
        href: "https://myapp.example.com",
        domain: "myapp.example.com",
        desc: "这是一个自己开发的项目",
        icon: "✨", avatarClass: "success",
        source: { type: "original", url: "https://github.com/user/myapp", note: "Flask + Vue 自研" }
      },
      {
        title: "基于开源改造示例",
        href: "https://fork.example.com",
        domain: "fork.example.com",
        desc: "基于某个开源项目改造",
        icon: "🍴", avatarClass: "warning",
        source: { type: "fork", url: "https://github.com/original/repo", note: "增加 OIDC 登录、暗黑主题、多语言支持" }
      }
    ]
  }
];
